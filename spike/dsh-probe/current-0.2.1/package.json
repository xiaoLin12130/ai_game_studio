{
  "name": "dsh-probe-current-021",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "PHASE 00-R1: drive DSH 0.2.1-rc.3 (the version the user actually runs) with the user's real commandcode provider",
  "scripts": {
    "setup": "node scripts/setup-profiles.mjs",
    "lock:update": "node scripts/setup-profiles.mjs --update-lock",
    "test:unit": "node tests/record-tests.mjs",
    "test:suite": "node run-all.mjs",
    "test": "node tests/record-tests.mjs && node run-all.mjs",
    "scrub": "node ../scrub-evidence.mjs --check",
    "probe:commandcode": "node src/probe-commandcode.mjs",
    "probe:tools": "node src/probe-cc-tools.mjs",
    "probe:capability": "node src/probe-capability.mjs",
    "probe:exit": "node src/probe-runtime-exit.mjs",
    "diag": "node src/studio-diag.mjs --both --replay evidence/cc-3-resume",
    "gates": "node scripts/run-gates.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.3"
  },
  "profilePlugins": {
    "@mars-sea/dsh-commandcode-provider": "0.15.4"
  },
  "//": "profilePlugins are installed INTO each isolated DSH profile by scripts/setup-profiles.mjs, not into this package. The runtime loads them from the profile node_modules, so they are declared here only to pin the exact version used by the evidence."
}
